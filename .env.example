# Server only. Never use VITE_ for an API key. Existing system environment works too.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AGENT_PORT=5181
AGENT_HOST=127.0.0.1
# Optional local V3 historical temperature tool.
URBANCOOL_LST_ROOT=
URBANCOOL_LST_PYTHON=
# Account workspace (npm run dev:accounts enables the first two switches).
URBANCOOL_ACCOUNTS=0
VITE_URBANCOOL_ACCOUNTS=0
URBANCOOL_ACCOUNT_DB=.runtime/accounts/workspace.sqlite
URBANCOOL_SITE_ORIGIN=
URBANCOOL_SECURE_COOKIE=0
# Optional administrator-approved OpenAI-compatible HTTPS base URLs (comma separated).
URBANCOOL_MODEL_ENDPOINTS=
QWEN_BASE_URL=http://127.0.0.1:18084/v1
QWEN_MODEL=epoch_2
QWEN_SPECIALIST_MODEL=base
QWEN_API_KEY=
# Huawei Cloud MaaS: each account saves its own API key in model settings.
HUAWEI_MAAS_BASE_URL=https://api.modelarts-maas.com/openai/v1
HUAWEI_MAAS_MODEL=
URBANCOOL_DEFAULT_PROVIDER=tuned
# Set disabled on a cloud host without a logged-in collection browser.
URBANCOOL_COLLECTOR_MODE=local
# Optional team Streamable HTTP MCP presets. See documentation/工作台启动与验收.md.
URBANCOOL_MCP_SERVERS=[]
# Optional absolute path to the Agent Reach executable for Xiaohongshu collection.
AGENT_REACH=
# Optional absolute path to the installed OpenCLI Node entry (replaces Agent Reach for Xiaohongshu).
OPENCLI_ENTRY=
OPENCLI_WINDOW=background
# Optional name of an existing local classifier container.
URBANCOOL_N8N_CONTAINER=urbancool-n8n
# Local workbench starts the existing classifier automatically. Cloud hosts never auto-start Docker.
URBANCOOL_CLASSIFIER_AUTOSTART=1
# Match the classifier container's host port; change this if Windows reserves 5678.
URBANCOOL_CLASSIFIER_ORIGIN=http://127.0.0.1:5678
