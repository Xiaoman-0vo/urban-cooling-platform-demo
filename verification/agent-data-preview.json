    {
      "type": "function",
      "function": {
        "name": "set_planning_goal",
        "description": "将用户明确给出的数字登记为目标草案；预算/候选面积/单价不得自行假设。金额单位元，面积㎡。",
        "parameters": {
          "type": "object",
          "properties": {
            "budget_rmb": {
              "type": "number",
              "description": "建设预算"
            },
            "candidate_area_m2": {
              "type": "number",
              "description": "用户声明的候选面积"
            },
            "unit_cost_rmb_per_m2": {
              "type": "number",
              "description": "假设建设单价"
            },
            "added_green_target_m2": {
              "type": "number",
              "description": "新增绿量目标"
            },
            "target_delta_lst_c": {
              "type": "number",
              "description": "期望地表降温"
            },
            "evidence_quote": {
              "type": "string",
              "description": "包含所登记数字的用户原话，必须逐字引用"
            }
          },
          "required": [
            "evidence_quote"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "generate_scenario_options",
        "description": "根据已登记预算、用户声明候选面积与假设单价生成三档配置目标；不是空间布局或降温优化。",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "compare_scenario_options",
        "description": "比较当前目标版本的草案面积和假设费用，旧版本单独标记。",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "request_temperature_prediction",
        "description": "用户明确要求预测时检查接入状态。当前必定返回未接通与空值，不会调用或虚构温度模型。",
        "parameters": {
          "type": "object",
          "properties": {
            "scenario_id": {
              "type": "string"
            }
          },
          "required": [
            "scenario_id"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "export_planning_report",
        "description": "将真实资料、当前目标及方案比较导出为带依据和假设的Markdown记录。",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      }
    }
  ],
