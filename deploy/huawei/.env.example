# Copy to .env on the deployment host. Set the real HTTPS origin before public use.
URBANCOOL_SITE_ORIGIN=https://replace-with-your-domain.example
URBANCOOL_HTTP_PORT=5181
HUAWEI_MAAS_BASE_URL=https://api.modelarts-maas.com/openai/v1
# Select a model enabled in your MaaS console that supports tool calling.
HUAWEI_MAAS_MODEL=
# Optional verified V3 directory for compose.v3.yaml. Model files stay outside the image.
URBANCOOL_LST_DIR=
